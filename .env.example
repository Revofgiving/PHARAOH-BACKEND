# ============================================================
# PHARAOH BACKEND - ENV ESEMPIO
# Release recovery: 4 settembre 2026 - FULLSTACK + Pharaoh Treasury Registry V3
# NON inserire mai chiavi reali nel repository/ZIP.
# ============================================================

PORT=4000
NODE_ENV=development
REQUEST_TIMEOUT_MS=60000
DATABASE_URL=postgresql://user:password@localhost:5432/pharaoh
CORS_ORIGIN=http://localhost:3002
ADMIN_API_KEY=CHANGE_ME_RANDOM_AT_LEAST_32_BYTES

# Polygon mainnet
POLYGON_RPC_URL=https://polygon-mainnet.example.invalid/v2/CHANGE_ME
POLYGON_CHAIN_ID=137
POLYGON_MIN_CONFIRMATIONS=2

# Circle USDC nativo su Polygon (6 decimali)
USDC_CONTRACT_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359

# Wallet PHARAOH - DEVONO essere distinti
PHARAOH_FUND_A_WALLET=0x0000000000000000000000000000000000000001
PHARAOH_TREASURY_WALLET=0x0000000000000000000000000000000000000002
# La stessa chiave Cassa PHARAOH firma i payout cross e, solo per RHA -> ROG,
# anche ROG.registerDonation(importo) dopo il Transfer USDC. Non copiarla in ROG.
PHARAOH_PAYOUT_PRIVATE_KEY=
PAYOUT_DEV_MODE=1

# DIRECT: ogni sessione e ESATTAMENTE 100 USDC PHARAOH = 1 posizione
PHARAOH_MAX_DIRECT_POSITIONS=1

# Pharaoh Treasury Registry V3 - registra solo i movimenti USDC da/per la Cassa PHARAOH.
# Questa chiave deve appartenere al wallet a cui il deployer assegna BACKEND_ROLE.
PHARAOH_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000004
PHARAOH_REGISTRY_PRIVATE_KEY=
PHARAOH_REGISTRY_WORKER_ENABLED=0
PHARAOH_REGISTRY_WORKER_INTERVAL_MS=60000
PHARAOH_REGISTRY_WORKER_BATCH=5

# ROG - Community + donazione DIRECT/GIFT
ROG_API_BASE_URL=https://rog-backend.165.245.209.171.nip.io
ROG_API_TIMEOUT_MS=30000
ROG_COMPLETION_API_TIMEOUT_MS=30000
ROG_FULFILLMENT_WORKER_ENABLED=1
ROG_FULFILLMENT_WORKER_INTERVAL_MS=15000
ROG_FULFILLMENT_WORKER_BATCH=5
ROG_TREASURY_WALLET=0xd5bcc7acc9d6862c784807134c1f70c3e7f9f790
ROG_CONTRACT_ADDRESS=0x0723a5d24afCe5732c9D5C00Ae580934d5664Aa0
ROG_USDC_CONTRACT_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
ROG_REQUIRED_DONATION_USDC=2

# URANUS - solo Cassa per i flussi applicativi gestiti dal backend.
# PharaohRegistry non dipende da UranusRegistry.
URANUS_TREASURY_WALLET=0x0000000000000000000000000000000000000020

# HMAC server-to-server. In production: casuale, >= 32 byte.
# Il segreto comune e il fallback. Se presenti, i due specifici prevalgono.
CROSS_PLATFORM_SECRET=CHANGE_ME_RANDOM_AT_LEAST_32_BYTES
ROG_CROSS_PLATFORM_SECRET=
URANUS_CROSS_PLATFORM_SECRET=

# Receiver dei movimenti automatici all'uscita RHA.
# Per ROG la sequenza backend e: Transfer USDC -> PharaohRegistry ->
# ROG.registerDonation(importo) dalla Cassa PHARAOH -> HMAC al receiver ROG.
# Devono essere HTTPS e verificati prima di abilitare il worker.
ROG_CROSS_INGRESS_URL=https://rog-backend.example.invalid/api/cross/donation/entrata
URANUS_CROSS_INGRESS_URL=https://uranus-backend.example.invalid/api/cross/donation/entrata
CROSS_OUTBOUND_TIMEOUT_MS=10000

# Fail-safe: lasciare 0 finche i receiver ROG/URANUS non hanno superato
# il preflight/live smoke controllato. Poi impostare esplicitamente 1.
CROSS_OUTBOUND_WORKER_ENABLED=0
CROSS_OUTBOUND_WORKER_INTERVAL_MS=60000
CROSS_OUTBOUND_WORKER_BATCH=10

# Optional: wallet controllato per preflight read-only Community ROG.
PREFLIGHT_TEST_WALLET=

# KYC / servizi opzionali esistenti
BACKEND_URL=https://pharaoh.example.invalid
POLYGON_ID_VERIFIER_DID=
POLYGON_ID_ALLOWED_ISSUERS=*
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=
JONNY_WHATSAPP=
PINATA_JWT=
PINATA_GATEWAY_URL=https://gateway.pinata.cloud
